# Copy to .env and fill in. Never commit .env.

# Required for default Claude path
ANTHROPIC_API_KEY=
PHA_PROVIDER=anthropic
PHA_MODEL=claude-sonnet-5

# Optional second vendor (pha-compare / PHA_PROVIDER=openai)
OPENAI_API_KEY=
# PHA_PROVIDER=openai
# PHA_MODEL=gpt-4o-mini

# Guardrails
PHA_MAX_STEPS=12
PHA_MAX_COST_USD=0.50

# Audit log actor (defaults to OS username)
PHA_ACTOR=
